# Generated by deploy.yml on every `make deploy` from vars.yml plus this
# playbook's own defaults — edit those instead of this file directly, it's
# overwritten on every run. docker-compose.yml reads every line below.

SERVER_NAME={{ mc_server_name }}
LEVEL_NAME={{ mc_level_name }}
LEVEL_SEED={{ mc_level_seed | default('') }}
GAMEMODE={{ mc_gamemode }}
DIFFICULTY={{ mc_difficulty }}
ALLOW_CHEATS={{ mc_allow_cheats | lower }}
MAX_PLAYERS={{ mc_max_players }}
ONLINE_MODE={{ mc_online_mode | lower }}
VIEW_DISTANCE={{ mc_view_distance }}
ALLOW_LIST={{ mc_allow_list | lower }}
ALLOW_LIST_USERS={{ mc_allow_list_users | default('') }}
OPS={{ mc_ops | default('') }}
SERVER_PORT={{ mc_server_port }}
SERVER_PORT_V6={{ mc_server_port_v6 }}
TZ={{ mc_timezone }}
