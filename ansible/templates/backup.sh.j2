#!/bin/bash
# Generated by deploy.yml — nightly world backup via Bedrock's own live
# save-hold/query/resume sequence, so it never stops the server or
# disconnects anyone mid-game. Old backups past the retention window are
# pruned automatically. Run by the pieceocraft-backup systemd timer; not
# meant to be edited by hand (edit deploy.yml's vars: block instead).
set -euo pipefail

cd "{{ project_dir }}"
mkdir -p backups

send() {
  docker compose exec -T bedrock send-command "$1" >/dev/null
}

# Always release the hold, even if something below fails — an interrupted
# script must never leave the server stuck refusing to save to disk.
trap 'send "save resume" 2>/dev/null || true' EXIT

send "save hold"

# "save query" returns "Saving..." until the hold is actually ready, then
# "Data saved. Files are now ready to be copied." — poll for that line.
ready=false
for _ in $(seq 1 30); do
  sleep 2
  if docker compose logs --tail=5 bedrock 2>&1 | grep -q "Data saved. Files are now ready to be copied"; then
    ready=true
    break
  fi
  send "save query"
done

if [ "$ready" = true ]; then
  tar czf "backups/pieceocraft-data-$(date +%Y-%m-%d).tar.gz" data
else
  echo "pieceocraft-backup: save hold never became ready, skipping this run" >&2
fi

find backups -name 'pieceocraft-data-*.tar.gz' -mtime "+{{ mc_auto_backup_retention_days }}" -delete
